{
  "name": "aminas-vasoativas-conversor",
  "version": "1.0.0",
  "private": true,
  "description": "Gera o .pptx editável a partir do deck em HTML (apresentacao/deck) e confere o layout",
  "scripts": {
    "pptx": "node html_para_pptx.js ../deck ../Aminas_Vasoativas.pptx",
    "verificar": "node verificar_layout.js ../deck"
  },
  "dependencies": {
    "@fontsource/gelasio": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "jszip": "3.10.2",
    "playwright": "1.56.1",
    "pptxgenjs": "4.0.1"
  }
}
